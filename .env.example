# Bank Transaction Categorizer - Environment Configuration
# Copy this file to .env and set your values. NEVER commit .env to GitHub!

# API Security: Secret key required in the 'X-API-Key' header
# If empty or not set, the API runs in permissive development mode.
API_KEY=your_secure_random_api_key_here

# Server Environment: development | production | testing
ENVIRONMENT=development

# CORS: Comma-separated list of allowed origins (e.g., http://localhost:8501,https://myapp.com)
# Defaults to wildcard (*) if left empty in development
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Minimum confidence threshold for fallback (0.0 to 1.0)
DEFAULT_MIN_CONFIDENCE=0.35

